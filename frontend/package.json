{
  "name": "gbtearock-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "岩茶做青与焙火工序台 - 纯前端 SPA（React 18 + TypeScript + Ant Design + Vite + Zustand + React Router + Dexie）",
  "scripts": {
    "dev": "vite --host --port 22823",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 22823",
    "typecheck": "tsc --noEmit",
    "test:dispatch": "esbuild scheduler-test.mts --bundle --platform=node --format=esm --outfile=node_modules/.cache/dispatch-test.mjs --log-level=warning && node node_modules/.cache/dispatch-test.mjs",
    "test:smoke": "esbuild component-smoke.mts --bundle --platform=node --format=esm --outfile=node_modules/.cache/component-smoke.mjs --log-level=warning --resolve-extensions=.tsx,.ts,.jsx,.js --external:jsdom --external:fake-indexeddb && node node_modules/.cache/component-smoke.mjs",
    "test": "npm run test:dispatch && npm run test:smoke"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.22.5",
    "dayjs": "^1.11.13",
    "dexie": "^4.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
